{
	"name": "@neuroblaze/pi-computer-use",
	"version": "0.6.0",
	"description": "Linux/X11 fork of pi-computer-use: a Pi extension that lets AI agents observe and control desktop apps.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"computer-use",
		"desktop-automation",
		"accessibility",
		"linux",
		"x11"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/neuroblaze/pi-computer-use.git"
	},
	"bugs": {
		"url": "https://github.com/neuroblaze/pi-computer-use/issues"
	},
	"homepage": "https://github.com/neuroblaze/pi-computer-use#readme",
	"engines": {
		"node": ">=20.6.0"
	},
	"files": [
		"extensions",
		"src",
		"scripts/build-native.mjs",
		"scripts/setup-helper.mjs",
		"native/linux/bridge-rs",
		"prebuilt/linux",
		"assets/reference/img.jpg",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "./assets/reference/img.jpg"
	},
	"scripts": {
		"postinstall": "node scripts/setup-helper.mjs --postinstall",
		"typecheck": "tsc -p tsconfig.json",
		"test:schema": "node scripts/check-tool-schemas.mjs",
		"test:find-params": "tsx scripts/check-find-params.mjs",
		"test:lifecycle": "tsx scripts/check-session-lifecycle.mjs",
		"test:runtime": "tsx scripts/check-runtime-concurrency.mjs",
		"test:output": "tsx scripts/check-bounded-output.mjs",
		"test:visual": "tsx scripts/check-visual.mjs",
		"test:package-assets": "node scripts/check-package-assets.mjs",
		"test:act-outcomes": "tsx scripts/check-act-outcomes.mjs",
		"test": "npm run typecheck && npm run test:schema && npm run test:find-params && npm run test:output && npm run test:visual && npm run test:lifecycle && npm run test:runtime && npm run test:linux && npm run test:linux-scripts && npm run test:act-outcomes",
		"build:linux": "node scripts/build-native.mjs --platform linux",
		"test:linux": "tsx scripts/check-platform-linux.mjs",
		"test:linux-scripts": "node scripts/check-linux-build-scripts.mjs",
		"test:linux-live": "PI_CU_LIVE=1 tsx scripts/check-linux-live.mjs",
		"test:visual-live": "PI_CU_LIVE=1 tsx scripts/check-visual-live.mjs"
	},
	"dependencies": {
		"jimp": "^0.22.12"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
